#!/usr/bin/env python3
"""Independent Work maintenance; never restarts Chat or restores user data."""
import argparse
import os
import re
import subprocess

parser = argparse.ArgumentParser()
parser.add_argument("action", choices=("status", "start", "stop", "tunnel"))
parser.add_argument("--host", default="mac@35.209.202.207")
args = parser.parse_args()
if not re.fullmatch(r"[a-zA-Z0-9_.-]+@[a-zA-Z0-9.-]+", args.host):
    raise SystemExit("invalid_ssh_target")
ssh = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10"]
if args.action == "tunnel":
    print("Alma 设置：http://127.0.0.1:23001；此窗口保持打开，Ctrl-C 关闭连接。", flush=True)
    os.execvp("ssh", [*ssh, "-o", "ExitOnForwardFailure=yes", "-o", "ServerAliveInterval=30",
        "-N", "-L", "127.0.0.1:23001:127.0.0.1:23001", args.host])
elif args.action in ("start", "stop"):
    subprocess.run([*ssh, args.host, "sudo -n systemctl " + args.action + " alma-work"], check=True)
    print("Work 启动中" if args.action == "start" else "Work 已停止；会话、配对和成果保留")
else:
    code = '''import json,subprocess,urllib.request
result={"service":subprocess.check_output(["systemctl","show","alma-work",
    "-p","ActiveState","-p","MemoryCurrent","-p","MemoryPeak","-p","MemoryMax"],text=True).strip()}
try:
    with urllib.request.urlopen("http://127.0.0.1:23001/api/health",timeout=5) as r:
        result["health"]=json.load(r).get("status")
    with urllib.request.urlopen("http://127.0.0.1:23001/api/mobile-relay/status",timeout=5) as r:
        relay=json.load(r)
    result.update(relay=relay.get("state"),encrypted=relay.get("e2eEncryption"),
        phone_connected=relay.get("phones",{}).get("connectedNow"))
except Exception:
    result["health"]="unavailable"
print(json.dumps(result,ensure_ascii=False))
'''
    subprocess.run([*ssh, args.host, "python3 -"], input=code, text=True, check=True)
