#!/usr/bin/env python3
"""Prepare/check a user-operated sleep test; never sleep or reboot the Mac."""

from datetime import datetime, timezone
import argparse
import json
import os
from pathlib import Path
import shlex
import subprocess
import uuid


MONITOR = r'''
from datetime import datetime,timezone
import json,os,sys,time,uuid
from pathlib import Path
sys.path.insert(0,'/home/mac/personal-asis/src')
from personal_asis.coordinator import Coordinator
base=Path(sys.argv[1])
home=Path('/home/mac/.local/share/personal-asis-coordinator')
proof={'phase':'waiting_for_sleep','started_at':datetime.now(timezone.utc).isoformat(),
       'kind':'manual_mac_sleep','messages_sent':False}
def save():
    temp=base/'proof.tmp'
    with temp.open('w') as f:json.dump(proof,f)
    temp.chmod(0o600)
    temp.replace(base/'proof.json')
save()
deadline=time.monotonic()+1800
tasks=None
try:
    while time.monotonic()<deadline:
        with Coordinator(home/'coordinator.sqlite3',nodes=('mac',)) as c:
            nodes=c.db.execute('SELECT * FROM nodes WHERE enabled=1').fetchall()
            if [n['id'] for n in nodes]!=['mac']:raise ValueError('unexpected_active_nodes')
            online=nodes[0]['last_seen'] is not None and c.clock()-nodes[0]['last_seen']<c.offline_after
            if tasks is None and not online:
                tasks={channel:c.submit('pa0sleep'+uuid.uuid4().hex,channel,5,
                        'pa0-sleep-'+uuid.uuid4().hex)['task_id'] for channel in ('pwa','feishu')}
                proof.update({'phase':'waiting_for_wake','offline_verified':True,
                              'offline_at':datetime.now(timezone.utc).isoformat(),'tasks':tasks})
                for task in tasks.values():
                    view=c.view(task)
                    if view['waiting_nodes']!=['mac'] or not view['partial']:
                        raise ValueError('offline_waiting_failed')
                save()
            if tasks is not None and online:
                views=[c.view(task) for task in tasks.values()]
                if all(v['state']=='completed' and not v['partial'] and not v['waiting_nodes']
                       and [n['node_id'] for n in v['nodes']]==['mac'] for v in views):
                    proof.update({'phase':'passed','same_tasks_resumed':True,
                                  'finished_at':datetime.now(timezone.utc).isoformat()})
                    save()
                    break
        time.sleep(5)
    else:
        proof['phase']='timed_out'
        save()
except Exception as error:
    proof.update({'phase':'failed','error_type':type(error).__name__})
    save()
'''


REMOTE = r'''
import json,os,subprocess,sys,uuid
from pathlib import Path
data=json.load(sys.stdin)
run=str(uuid.UUID(data['run_id']))
base=Path('/home/mac/.local/share/personal-asis-coordinator/pa0-sleep-check')/run
if data['action']=='prepare':
    base.mkdir(parents=True,mode=0o700)
    base.parent.chmod(0o700)
    script=base/'monitor.py'
    script.write_text(data['script'])
    script.chmod(0o600)
    with open(os.devnull,'wb') as sink:
        process=subprocess.Popen([sys.executable,str(script),str(base)],stdin=subprocess.DEVNULL,
                                 stdout=sink,stderr=sink,start_new_session=True)
    print(json.dumps({'phase':'prepared','pid':process.pid}))
else:
    print((base/'proof.json').read_text())
'''


def remote(host, data):
    result = subprocess.run(['ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10',
        '-o', 'ServerAliveInterval=5', '-o', 'ServerAliveCountMax=2', '-p', '22', host,
        'python3 -c ' + shlex.quote(REMOTE)], input=json.dumps(data), text=True,
        capture_output=True, timeout=30, check=True)
    return json.loads(result.stdout)


def power_events(since):
    result = subprocess.run(['pmset', '-g', 'log'], text=True, capture_output=True, timeout=30, check=True)
    sleeps, wakes = [], []
    for line in result.stdout.splitlines():
        try:
            at = datetime.strptime(line[:25], '%Y-%m-%d %H:%M:%S %z').astimezone(timezone.utc)
        except ValueError:
            continue
        if at < since:
            continue
        if 'Entering Sleep state' in line:
            sleeps.append(at.isoformat())
        elif 'FullWake' in line or ('Wake from' in line and 'DarkWake from' not in line):
            wakes.append(at.isoformat())
    return {'sleep_events': sleeps, 'full_wake_events': wakes,
            'physical_sleep_and_wake_seen': bool(sleeps and any(wake > sleeps[0] for wake in wakes))}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['prepare', 'status'])
    parser.add_argument('--host', default='mac@35.209.202.207')
    args = parser.parse_args()
    os.umask(0o077)
    output = Path.home() / 'Library/Application Support/PersonalAsis/pa0-sleep-check.json'
    if args.action == 'prepare':
        if output.exists():
            old = json.loads(output.read_text())
            state = remote(old['host'], {'action':'status','run_id':old['run_id']})
            if state['phase'] in {'waiting_for_sleep','waiting_for_wake'}:
                raise ValueError('sleep_test_already_pending')
        record = {'run_id':str(uuid.uuid4()),'host':args.host}
        remote(args.host, {'action':'prepare','run_id':record['run_id'],'script':MONITOR})
        with output.open('w') as handle:
            json.dump(record,handle)
        output.chmod(0o600)
        print(json.dumps({'prepared':True,'expires_in_minutes':30,'sleep_mac_manually':True}))
    else:
        record = json.loads(output.read_text())
        proof = remote(record['host'], {'action':'status','run_id':record['run_id']})
        if proof['phase'] == 'passed':
            proof.update(power_events(datetime.fromisoformat(proof['started_at'])))
            record['proof'] = proof
            with output.open('w') as handle:
                json.dump(record,handle,indent=2)
        print(json.dumps({k:proof[k] for k in ['phase','offline_verified','same_tasks_resumed',
                    'physical_sleep_and_wake_seen','error_type'] if k in proof}))


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print(json.dumps({'passed':False,'error_type':type(error).__name__}))
        raise SystemExit(1)
