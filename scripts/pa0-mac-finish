#!/usr/bin/env python3
"""Mac-local PA0 update, encrypted recovery drill and temporary replica fixture."""

import hashlib
import io
import json
import os
from pathlib import Path
import plistlib
import shutil
import sqlite3
import subprocess
import sys
import tarfile
import tempfile
import time


HOST = "mac@35.209.202.207"
REMOTE = "/home/mac/personal-asis/scripts/"
STEP = "preflight"
LOG = None


def fetch(name):
    result = subprocess.run(["ssh", "-o", "ConnectTimeout=15", "-p", "22", HOST, "cat", REMOTE + name],
                            capture_output=True, timeout=120, check=True)
    if len(result.stdout) > 32 * 1024**2:
        raise ValueError("release_too_large")
    return result.stdout


def run(argv, env, timeout=120):
    result = subprocess.run(argv, env=env, capture_output=True, timeout=timeout)
    if result.returncode:
        if LOG:
            LOG.write_bytes(result.stdout + result.stderr)
        raise ValueError("local_validation_failed")
    return result.stdout


def atomic(path, raw):
    temporary = path.with_name(path.name + ".pa0.tmp")
    with temporary.open("wb") as handle:
        os.chmod(temporary, 0o600)
        handle.write(raw)
    os.replace(temporary, path)


def main():
    global STEP, LOG
    if sys.platform != "darwin":
        raise ValueError("run_on_mac_only")
    os.umask(0o077)
    home = Path.home() / "Library/Application Support/PersonalAsis"
    LOG = home / "pa0-upgrade-step.log"
    config_path = home / "sources.yaml"
    original_config = config_path.read_bytes()
    config = json.loads(original_config)
    if config["node_id"] != "mac" or any(s["id"] == "pa0-acceptance" for s in config["sources"]):
        raise ValueError("expected_existing_mac_without_fixture")
    plist = Path.home() / "Library/LaunchAgents/local.personal-asis.mac.plist"
    original_plist = plist.read_bytes()
    service = plistlib.loads(original_plist)
    base_python = service["ProgramArguments"][0]
    env = os.environ.copy()
    STEP = "download_release"
    manifest = json.loads(fetch("pa0-mac-release.json"))
    name, expected = manifest["filename"], manifest["sha256"]
    if not name.startswith("pa0-mac-release-") or Path(name).name != name or len(expected) != 64:
        raise ValueError("invalid_release_manifest")
    raw = fetch(name)
    if hashlib.sha256(raw).hexdigest() != expected:
        raise ValueError("release_hash_mismatch")
    releases = home / "code-releases"
    releases.mkdir(mode=0o700, exist_ok=True)
    release = releases / expected[:16]
    if not release.exists():
        with tempfile.TemporaryDirectory(prefix="prepare-", dir=releases) as temporary:
            stage = Path(temporary) / "code"
            stage.mkdir(mode=0o700)
            with tarfile.open(fileobj=io.BytesIO(raw), mode="r:gz") as archive:
                for member in archive:
                    relative = Path(member.name)
                    if (relative.is_absolute() or ".." in relative.parts or not relative.parts
                            or relative.parts[0] not in {"src", "scripts", "tests", "pyproject.toml"}
                            or not (member.isdir() or member.isfile())):
                        raise ValueError("invalid_release_member")
                    target = stage / relative
                    if member.isdir():
                        target.mkdir(parents=True, exist_ok=True, mode=0o700)
                    else:
                        target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
                        with target.open("xb") as output:
                            shutil.copyfileobj(archive.extractfile(member), output)
                        target.chmod(0o600)
            stage.rename(release)
    venv = home / "pa0-text-env"
    STEP = "prepare_python_environment"
    python = venv / "bin/python"
    if not python.exists():
        run([base_python, "-m", "venv", str(venv)], env)
    STEP = "install_cryptography"
    run([str(python), "-m", "pip", "install", "cryptography>=44"], env, 300)
    env["PYTHONPATH"] = str(release / "src")
    argv = [str(python), "-m", "personal_asis", "--home", str(home)]
    STEP = "runtime_doctor"
    doctor = json.loads(run(argv + ["doctor"], env))
    if not doctor["fts5_trigram"] or not doctor["encrypted_backup"]:
        raise ValueError("runtime_capability_missing")
    STEP = "synthetic_tests"
    validation = subprocess.run([str(python), "-m", "unittest", "discover", "-s", str(release / "tests"), "-q"],
                                env=env, capture_output=True, timeout=180)
    (home / "pa0-upgrade-validation.log").write_bytes(validation.stdout + validation.stderr)
    if validation.returncode:
        raise ValueError("release_tests_failed")
    print(json.dumps({"release_tests_passed": True}), flush=True)
    STEP = "local_rollback_snapshot"
    # Keep a local rollback snapshot; neither configuration nor index leaves this Mac.
    rollback = home / "upgrade-rollback" / time.strftime("%Y%m%dT%H%M%S")
    rollback.mkdir(parents=True, mode=0o700)
    (rollback / "sources.yaml").write_bytes(original_config)
    (rollback / "service.plist").write_bytes(original_plist)
    domain = "gui/" + str(os.getuid())
    label = "local.personal-asis.mac"
    with sqlite3.connect(home / "index.sqlite3") as source, sqlite3.connect(rollback / "index.sqlite3") as target:
        source.backup(target)
    # This explicit grant only covers nonprivate text already allowed metadata.
    for source in config["sources"]:
        source["remote_evidence"] = source["policy"] == "normal" and source.get("remote_metadata", False)
    updated = (json.dumps(config, ensure_ascii=False, indent=2) + "\n").encode()
    try:
        STEP = "activate_local_service"
        subprocess.run(["launchctl", "bootout", domain + "/" + label], capture_output=True)
        atomic(config_path, updated)
        run(argv + ["reconcile"], env)
        run(argv + ["service", "install"], env)
    except Exception:
        subprocess.run(["launchctl", "bootout", domain + "/" + label], capture_output=True)
        if config_path.read_bytes() == updated:
            atomic(config_path, original_config)
        # The old binary rejects schema 2, so restore its own consistent snapshot.
        for suffix in ("-wal", "-shm"):
            (home / ("index.sqlite3" + suffix)).unlink(missing_ok=True)
        shutil.copyfile(rollback / "index.sqlite3", home / "index.sqlite3")
        atomic(plist, original_plist)
        subprocess.run(["launchctl", "bootstrap", domain, str(plist)], capture_output=True)
        raise
    permission = home / "source-permissions.json"
    grants = json.loads(permission.read_text()) if permission.exists() else {}
    if isinstance(grants, dict):
        grants["nonprivate_pwa_text"] = {"enabled": True, "scope": "metadata-authorized nonprivate documents only",
            "transport": "end-to-end encrypted ephemeral relay", "private_body": False, "cloud_model": False}
        atomic(permission, json.dumps(grants, ensure_ascii=False, indent=2).encode())
    STEP = "encrypted_backup"
    backup = json.loads(run(argv + ["backup", "create", "--target", str(home / "encrypted-backups")], env, 300))
    with tempfile.TemporaryDirectory(prefix="restore-drill-", dir=home) as temporary:
        STEP = "restore_drill"
        target = Path(temporary) / "restored"
        restored = json.loads(run(argv + ["backup", "restore", "--archive", backup["path"],
                                       "--target", str(target), "--node-id", "mac"], env, 300))
        with sqlite3.connect(home / "index.sqlite3") as current, sqlite3.connect(target / "index.sqlite3") as recovered:
            query = "SELECT document_id,content_hash,source_id,path FROM documents WHERE active=1 ORDER BY document_id"
            identical = current.execute(query).fetchall() == recovered.execute(query).fetchall()
        if not restored["restored"] or not identical:
            raise ValueError("backup_identity_check_failed")
    proof = {"mac_upgrade_ready": True, "release": expected[:16], "backup_restore_verified": True, "backup_location": backup["path"],
             "backup_copied_to_rog": False, "same_document_identities": identical}
    atomic(home / "pa0-upgrade-proof.json", json.dumps(proof, indent=2).encode())
    print(json.dumps(proof), flush=True)
    # Keep the terminal running for the actual cross-device checks.
    STEP = "replica_fixture"
    return subprocess.call([str(python), str(release / "scripts/pa0-mac-acceptance")], env=env)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print(json.dumps({"failed_step": STEP, "error_type": type(error).__name__}), file=sys.stderr)
        if STEP == "synthetic_tests":
            # Only synthetic tests run here; no source text is present in this log.
            log = Path.home() / "Library/Application Support/PersonalAsis/pa0-upgrade-validation.log"
            if log.exists():
                print(log.read_text(errors="replace")[-8000:], file=sys.stderr)
        elif LOG and LOG.exists():
            print("Local details: " + str(LOG), file=sys.stderr)
        print("Mac PA0 setup failed. Source originals were not edited; inspect the local validation log.", file=sys.stderr)
        raise SystemExit(1)
