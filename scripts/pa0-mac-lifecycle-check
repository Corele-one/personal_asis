#!/usr/bin/env python3
"""Verify live Mac service restart and offline recovery, without source changes."""

import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import time
import uuid


REMOTE = """
import json,sys
from pathlib import Path
sys.path.insert(0,'/home/mac/personal-asis/src')
from personal_asis.coordinator import Coordinator
data=json.load(sys.stdin)
with Coordinator(Path('/home/mac/.local/share/personal-asis-coordinator/coordinator.sqlite3'), nodes=('mac',)) as c:
    if data['op']=='status':
        value={'nodes':[r['id'] for r in c.db.execute('SELECT id FROM nodes WHERE enabled=1')],
               'online':any(r['last_seen'] is not None and c.clock()-r['last_seen']<c.offline_after
                            for r in c.db.execute("SELECT * FROM nodes WHERE id='mac' AND enabled=1")),
               'offline_after':c.offline_after}
    elif data['op']=='submit':
        value=c.submit(data['query'],data['channel'],5,data['request_id'])
    elif data['op']=='view':
        v=c.view(data['task_id'])
        value={'state':v['state'],'partial':v['partial'],'waiting_nodes':v['waiting_nodes'],
               'nodes':[n['node_id'] for n in v['nodes']],
               'online':[n['online'] for n in v['nodes']],
               'result_groups':len(v['results'])}
    else:
        raise ValueError('unknown_operation')
print(json.dumps(value))
"""


def remote(host, **data):
    result = subprocess.run(
        ['ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10',
         '-o', 'ServerAliveInterval=5', '-o', 'ServerAliveCountMax=2',
         '-p', '22', host, 'python3 -c ' + shlex.quote(REMOTE)],
        input=json.dumps(data), capture_output=True, text=True, timeout=30, check=True)
    return json.loads(result.stdout)


def launch(*args):
    return subprocess.run(['launchctl', *args], capture_output=True, text=True, timeout=30)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--host', default='mac@35.209.202.207')
    args = parser.parse_args()
    if sys.platform != 'darwin':
        raise ValueError('run_on_the_owning_mac')
    home = Path.home() / 'Library/Application Support/PersonalAsis'
    plist = Path.home() / 'Library/LaunchAgents/local.personal-asis.mac.plist'
    domain = f'gui/{os.getuid()}'
    target = domain + '/local.personal-asis.mac'
    before = remote(args.host, op='status')
    if before['nodes'] != ['mac'] or not before['online']:
        raise ValueError('expected_online_mac_only')
    if not plist.is_file() or launch('print', target).returncode:
        raise ValueError('existing_mac_service_required')
    proof = {'started_at': datetime.now(timezone.utc).isoformat(),
             'kind': 'real_service_restart_and_offline_recovery',
             'physical_sleep_tested': False, 'source_changes': False,
             'feishu_messages_sent': False}
    stopped = False

    def restore():
        nonlocal stopped
        if stopped:
            result = launch('bootstrap', domain, str(plist))
            if result.returncode and launch('print', target).returncode:
                raise ValueError('restore_service_failed')
            launch('kickstart', target).check_returncode()
            stopped = False

    try:
        launch('bootout', target).check_returncode()
        stopped = True
        print(json.dumps({'stage': 'mac_service_stopped', 'expected_wait_seconds': before['offline_after'] + 5}), flush=True)
        tasks = {channel: remote(args.host, op='submit', channel=channel,
                                query='pa0lifecycle' + uuid.uuid4().hex,
                                request_id='pa0-final-' + uuid.uuid4().hex)['task_id']
                 for channel in ('pwa', 'feishu')}
        deadline = time.monotonic() + before['offline_after'] + 45
        while True:
            status = remote(args.host, op='status')
            if not status['online']:
                break
            if time.monotonic() >= deadline:
                raise ValueError('mac_did_not_become_offline')
            time.sleep(10)
        waiting = {channel: remote(args.host, op='view', task_id=task) for channel, task in tasks.items()}
        if not all(v['partial'] and v['waiting_nodes'] == ['mac']
                   and v['nodes'] == ['mac'] and v['online'] == [False] for v in waiting.values()):
            raise ValueError('offline_waiting_scope_failed')
        proof['offline_waiting'] = waiting
        print(json.dumps({'stage': 'offline_waiting_verified', 'channels': list(tasks)}), flush=True)
        restore()
        print(json.dumps({'stage': 'mac_service_restarted'}), flush=True)
        deadline = time.monotonic() + 180
        while True:
            done = {channel: remote(args.host, op='view', task_id=task) for channel, task in tasks.items()}
            if all(v['state'] == 'completed' and not v['partial']
                   and not v['waiting_nodes'] and v['nodes'] == ['mac'] for v in done.values()):
                break
            if time.monotonic() >= deadline:
                raise ValueError('same_tasks_did_not_complete_after_restart')
            time.sleep(10)
        proof.update({'completed': done, 'same_tasks_resumed': True,
                      'finished_at': datetime.now(timezone.utc).isoformat()})
        output = home / 'pa0-final-lifecycle-proof.json'
        descriptor = os.open(output, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(descriptor, 'w') as handle:
            json.dump(proof, handle, ensure_ascii=False, indent=2)
            handle.write('\n')
        print(json.dumps({'stage': 'passed', 'same_tasks_resumed': True,
                          'physical_sleep_tested': False, 'proof_saved_locally': True}), flush=True)
        return 0
    finally:
        restore()


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(json.dumps({'passed': False, 'error_type': type(error).__name__}), file=sys.stderr)
        raise SystemExit(1)
