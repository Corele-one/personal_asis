#!/usr/bin/env python3
"""Stage code-only files and activate the existing authorized VPS environment."""
import argparse
import hashlib
import json
from pathlib import Path
import re
import shutil
import subprocess
import tempfile
import tarfile
import uuid

repo=Path(__file__).resolve().parents[1]
p=argparse.ArgumentParser();p.add_argument('--host',default='mac@35.209.202.207');p.add_argument('--port',type=int,default=22)
p.add_argument('--check-only', action='store_true', help='Validate the staged release with the installed SDK without activating services')
args=p.parse_args()
if not re.fullmatch(r'[a-zA-Z0-9_.-]+@[a-zA-Z0-9.-]+',args.host) or not 1<=args.port<=65535:raise SystemExit('invalid_ssh_target')
with tempfile.TemporaryDirectory(prefix='asis-life-release-') as tmp:
    stage=Path(tmp)/uuid.uuid4().hex;pkg=stage/'src/personal_asis';pkg.mkdir(parents=True)
    for name in ('__init__.py','life_store.py','life_images.py','life_image_export.py','life_intake.py','life_feedback.py','life_bedtime.py','life_tracking.py','life_attention.py','life_briefing.py','life_export.py','life_status.py','dashboard.py','overview.py','chat_status.py','learning_history.py','web_auth.py','http_errors.py','mac_content.py','bootstrap_context.py','personal_profile.py','profile_transfer.py','shared_store.py','shared_query.py','shared_sources.py','shared_transfer.py','shared_cli.py','data_policy.py'):
        shutil.copyfile(repo/'src/personal_asis'/name,pkg/name)
    (pkg/'web').mkdir()
    for f in (repo/'src/personal_asis/web').glob('dashboard*'):shutil.copyfile(f,pkg/'web'/f.name)
    plugin=stage/'astrbot_plugin_life_agent';shutil.copytree(repo/'integrations/astrbot_plugin_life_agent',plugin,ignore=shutil.ignore_patterns('__pycache__'))
    router=stage/'astrbot_plugin_smart_router'
    shutil.copytree(repo/'integrations/astrbot_plugin_smart_router',router,ignore=shutil.ignore_patterns('__pycache__'))
    shutil.copyfile(repo/'src/personal_asis/llm_router.py',router/'llm_router.py')
    shutil.copyfile(repo/'src/personal_asis/conversation_memory.py',router/'conversation_memory.py')
    shutil.copyfile(repo/'src/personal_asis/model_display.py',router/'model_display.py')
    shutil.copyfile(repo/'src/personal_asis/model_display.py',pkg/'model_display.py')
    shutil.copyfile(repo/'src/personal_asis/model_display.py',plugin/'model_display.py')
    shutil.copyfile(repo/'deploy/validate-router-sdk.py',stage/'validate-router-sdk.py')
    shutil.copyfile(repo/'src/personal_asis/life_store.py',plugin/'life_store.py')
    shutil.copyfile(repo/'src/personal_asis/life_bedtime.py',plugin/'life_bedtime.py')
    shutil.copyfile(repo/'src/personal_asis/bootstrap_context.py',plugin/'bootstrap_context.py')
    shutil.copyfile(repo/'src/personal_asis/personal_profile.py',plugin/'personal_profile.py')
    for name in ('chat_ui.py','chat_status.py','life_images.py','life_intake.py','life_feedback.py','life_tracking.py','life_attention.py','life_briefing.py','learning_history.py','shared_store.py','shared_query.py','shared_sources.py','shared_cli.py','data_policy.py','wucai_cli.py','wucai_fulltext.py','wucai_chat.py'):
        shutil.copyfile(repo/'src/personal_asis'/name,plugin/name)
    for name in ('personal-asis-dashboard.service','activate-life-vps.py','rollback-life-vps.py','validate-life-sdk.py','validate-chat-isolation-sdk.py','validate-chat-ui-sdk.py'):
        shutil.copyfile(repo/'deploy'/name,stage/name)
    manifest={str(f.relative_to(stage)):hashlib.sha256(f.read_bytes()).hexdigest() for f in stage.rglob('*') if f.is_file()}
    (stage/'manifest.json').write_text(json.dumps(manifest))
    ssh=['ssh','-o','BatchMode=yes','-p',str(args.port),args.host]
    subprocess.run([*ssh,'mkdir -p -m 700 /home/mac/personal-asis-v2-incoming'],check=True)
    archive=Path(tmp)/'release.tar.gz'
    with tarfile.open(archive,'w:gz') as bundle:
        bundle.add(stage,arcname=stage.name)
    with archive.open('rb') as payload:
        subprocess.run([*ssh,'tar -xzf - -C /home/mac/personal-asis-v2-incoming'],stdin=payload,check=True)
    remote='/home/mac/personal-asis-v2-incoming/'+stage.name
    if args.check_only:
        for check in ('validate-life-sdk.py','validate-chat-isolation-sdk.py','validate-chat-ui-sdk.py','validate-router-sdk.py'):
            subprocess.run([*ssh, '/home/mac/.local/share/uv/tools/astrbot/bin/python '+remote+'/'+check+' '+remote],check=True)
        print(json.dumps(dict(staged=remote)),flush=True)
    else:
        subprocess.run([*ssh,'python3 '+remote+'/activate-life-vps.py '+remote],check=True)
