#!/usr/bin/env python3
"""Send an existing Mac-encrypted backup to ROG through an ephemeral SSH FIFO."""

import hashlib
import json
from pathlib import Path
import shlex
import subprocess
import sys


HOST = "mac@35.209.202.207"
CONFIG = "/home/mac/personal-asis/scripts/pa0-mac-backup-relay.json"
BASE = "/home/mac/.local/share/personal-asis-coordinator/backup-transfer/"


def ssh(program, data=None, file=None):
    command = ["ssh", "-o", "ConnectTimeout=15", "-p", "22", HOST, "python3 -c " + shlex.quote(program)]
    return subprocess.run(command, input=data, stdin=file, capture_output=True, timeout=300, check=True).stdout


def main():
    if sys.platform != "darwin":
        raise ValueError("run_on_mac_only")
    home = Path.home() / "Library/Application Support/PersonalAsis"
    proof = json.loads((home / "pa0-upgrade-proof.json").read_text())
    if not proof.get("backup_restore_verified"):
        raise ValueError("restore_verification_required")
    backup = Path(proof["backup_location"])
    if backup.is_symlink() or backup.parent != home / "encrypted-backups":
        raise ValueError("invalid_backup_path")
    with backup.open("rb") as handle:
        if handle.read(8) != b"ASISBAK1":
            raise ValueError("expected_encrypted_backup")
    if not 36 < backup.stat().st_size <= 512 * 1024**2:
        raise ValueError("backup_size_limit")
    digest = hashlib.sha256()
    with backup.open("rb") as handle:
        for block in iter(lambda: handle.read(1024**2), b""):
            digest.update(block)
    config = json.loads(ssh("from pathlib import Path; print(Path(" + repr(CONFIG) + ").read_text())"))
    session = config["session"]
    if len(session) != 32 or any(c not in "0123456789abcdef" for c in session):
        raise ValueError("invalid_transfer_session")
    fifo = BASE + session + ".fifo"
    metadata = {"session": session, "bytes": backup.stat().st_size, "sha256": digest.hexdigest(), "node_id": "mac", "restore_verified": True}
    program = "import json,os,sys\nfrom pathlib import Path\np=Path(" + repr(BASE + session + ".json") + ")\np.write_text(json.dumps(json.load(sys.stdin)))\nos.chmod(p,0o600)"
    ssh(program, data=json.dumps(metadata).encode())
    program = "import os,shutil,stat,sys\nfd=os.open(" + repr(fifo) + ",os.O_WRONLY|os.O_NOFOLLOW)\nif not stat.S_ISFIFO(os.fstat(fd).st_mode): raise ValueError('expected_fifo')\nwith os.fdopen(fd,'wb') as target: shutil.copyfileobj(sys.stdin.buffer,target)"
    with backup.open("rb") as handle:
        ssh(program, file=handle)
    print(json.dumps({"encrypted_mac_backup_sent": True, "bytes": metadata["bytes"], "sha256": metadata["sha256"],
                      "plaintext_or_key_sent": False, "vps_backup_file_created": False}), flush=True)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        print("Encrypted backup transfer failed; the original Mac backup and key remain local.", file=sys.stderr)
        raise SystemExit(1)
