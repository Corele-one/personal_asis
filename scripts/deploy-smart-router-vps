#!/usr/bin/env python3
"""Stage only router code and the two native Life entrypoints, then activate."""
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import tempfile
import uuid

repo=Path(__file__).resolve().parents[1]
ssh=['ssh','-o','BatchMode=yes','mac@35.209.202.207']
with tempfile.TemporaryDirectory(prefix='asis-router-release-') as temp:
    stage=Path(temp)/uuid.uuid4().hex;stage.mkdir()
    plugin=stage/'astrbot_plugin_smart_router'
    shutil.copytree(repo/'integrations/astrbot_plugin_smart_router',plugin,
                    ignore=shutil.ignore_patterns('__pycache__'))
    shutil.copyfile(repo/'src/personal_asis/llm_router.py',plugin/'llm_router.py')
    shutil.copyfile(repo/'src/personal_asis/conversation_memory.py',plugin/'conversation_memory.py')
    shutil.copyfile(repo/'src/personal_asis/model_display.py',plugin/'model_display.py')
    shutil.copyfile(repo/'src/personal_asis/model_display.py',stage/'model_display.py')
    for name in ('briefing_agent.py','feedback_agent.py'):
        shutil.copyfile(repo/'integrations/astrbot_plugin_life_agent'/name,stage/name)
    for name in ('activate-router-vps.py','rollback-router-vps.py','validate-router-sdk.py','router-live-check.py'):
        shutil.copyfile(repo/'deploy'/name,stage/name)
    files={str(f.relative_to(stage)):hashlib.sha256(f.read_bytes()).hexdigest()
           for f in stage.rglob('*') if f.is_file()}
    (stage/'manifest.json').write_text(json.dumps(files))
    subprocess.run([*ssh,'mkdir -p -m 700 /home/mac/personal-asis-router-incoming'],check=True)
    subprocess.run(['scp','-q','-r',str(stage),'mac@35.209.202.207:/home/mac/personal-asis-router-incoming/'],check=True)
    remote='/home/mac/personal-asis-router-incoming/'+stage.name
    subprocess.run([*ssh,'/home/mac/.local/share/uv/tools/astrbot/bin/python '+remote+'/activate-router-vps.py '+remote],check=True)
