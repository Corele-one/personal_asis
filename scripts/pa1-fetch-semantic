#!/usr/bin/env python3
"""Explicit public-weight download; retrieval itself remains offline."""
import argparse
import json
import os
from pathlib import Path


MODEL = 'intfloat/multilingual-e5-small'
REVISION = '614241f622f53c4eeff9890bdc4f31cfecc418b3'
FILES = ['config.json', 'modules.json', 'model.safetensors', '1_Pooling/config.json',
         'sentence_bert_config.json', 'special_tokens_map.json', 'tokenizer.json',
         'tokenizer_config.json', 'sentencepiece.bpe.model']


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--target', type=Path, required=True)
    args = parser.parse_args()
    target = args.target.expanduser().absolute()
    target.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.environ['HF_HUB_DISABLE_TELEMETRY'] = '1'
    from huggingface_hub import snapshot_download
    snapshot_download(MODEL, revision=REVISION, allow_patterns=FILES,
                      local_dir=str(target), token=False, max_workers=2)
    if any(not (target / name).is_file() for name in FILES):
        raise SystemExit('incomplete_semantic_model_download')
    manifest = {'model':MODEL, 'revision':REVISION, 'files':FILES,
                'query_prefix':'query: ', 'document_prefix':'passage: '}
    (target / 'asis-model.json').write_text(json.dumps(manifest, indent=2) + '\n')
    print(json.dumps({'downloaded':True, **manifest}, indent=2))


if __name__ == '__main__':
    main()
