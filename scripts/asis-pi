#!/bin/sh
ASIS_REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
ASIS_PI_PYTHON=${ASIS_PYTHON:-"$HOME/Library/Application Support/PersonalAsis/pa1-env/bin/python"}
export PYTHONPATH="$ASIS_REPO_ROOT/src"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_HUB_DISABLE_TELEMETRY=1
export TOKENIZERS_PARALLELISM=false
exec "$ASIS_PI_PYTHON" -m personal_asis.pi_terminal "$@"
